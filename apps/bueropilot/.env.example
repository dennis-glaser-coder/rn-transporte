# Supabase Project Settings > API (the anon key is public, never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only; paste into Vercel project environment variables, never GitHub
RN_AI_CHAT_URL=
RN_AI_API_KEY=
RN_AI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Disable paid audio requests until ready
RN_VOICE_ENABLED=false
